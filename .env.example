# Use an absolute path outside OneDrive with at least 30 GB free.
THESIS_DATA_ROOT=C:\path\outside\OneDrive\thesis-data

# Optional local AI support. Disabled by default.
THESIS_ENABLE_AI=false
OLLAMA_BASE_URL=http://localhost:11434

# Live honeypots are never enabled by this project configuration.
THESIS_ENABLE_HONEYPOT_REPLAY=false

